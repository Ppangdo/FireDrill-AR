# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
LLM_MODE=fake            # claude | fake | off  (claude without a key runs as off)
DEVICE_TOKENS=pc-01:dev-token-change-me,staff:staff-token-change-me   # device:token, comma-separated
DATABASE_URL=sqlite:///./firedrill.db   # relative paths resolve against server/

# Optional overrides (defaults in app/settings.py)
# NPC_TIMEOUT_S=3
# REPORT_TIMEOUT_S=10
# WS_PING_INTERVAL_S=2
