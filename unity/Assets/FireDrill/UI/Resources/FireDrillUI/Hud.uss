/* 16.11 screens (UiRoot.uxml). Reference pixels (runtime.json ui.reference_resolution). */
.root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(240, 242, 245); font-size: 22px; }
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.banner { position: absolute; top: 24px; left: 25%; right: 25%; padding: 10px 16px; -unity-text-align: middle-center;
          background-color: rgba(200, 120, 20, 0.85); border-radius: 6px; font-size: 22px; }
.prompt { position: absolute; top: 56%; left: 0; right: 0; -unity-text-align: middle-center; font-size: 20px;
          color: rgb(255, 255, 255); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }
.subtitle { position: absolute; bottom: 36%; left: 10%; right: 10%; -unity-text-align: middle-center; font-size: 28px;
            white-space: normal; color: rgb(255, 255, 255); text-shadow: 1px 1px 3px rgba(0, 0, 0, 1); }
.inventory { position: absolute; right: 28px; bottom: 24px; padding: 10px;
             border-radius: 12px; background-color: rgba(13, 20, 29, 0.92); }
.inventory.above-dialogue { bottom: 35%; }
.inventory-slots { flex-direction: row; }
.inventory-slot { width: 178px; min-height: 72px; padding: 8px 10px; margin: 0 3px;
                  border-width: 1px; border-color: rgb(71, 86, 103); border-radius: 8px;
                  background-color: rgb(28, 40, 54); }
.inventory-slot.held { border-color: rgb(101, 171, 255); background-color: rgb(34, 56, 82); }
.slot-title { font-size: 15px; color: rgb(191, 210, 230); }
.slot-item { font-size: 22px; -unity-font-style: bold; }
.item-help { margin-top: 5px; font-size: 16px; color: rgb(228, 237, 247); }
.towel-help { color: rgb(167, 224, 211); }
.abort-hold { position: absolute; left: 28px; bottom: 24px; font-size: 18px; color: rgb(255, 170, 150); }
.dialogue { position: absolute; left: 12%; right: 12%; bottom: 3%; height: 30%; padding: 18px 26px;
            background-color: rgba(16, 18, 22, 0.88); border-radius: 10px; }
.speaker { font-size: 22px; -unity-font-style: bold; color: rgb(255, 210, 140); margin-bottom: 6px; }
.line { font-size: 26px; white-space: normal; margin-bottom: 10px; }
.choices { flex-direction: column; }
.choice { font-size: 22px; padding: 8px 14px; margin: 3px 0; -unity-text-align: middle-left;
          background-color: rgb(46, 52, 62); color: rgb(240, 242, 245); border-width: 0; border-radius: 6px; }
.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;
          background-color: rgba(12, 14, 18, 0.96); }
.screen.dim { background-color: rgba(0, 0, 0, 0.55); }
.card { width: 980px; padding: 34px 44px; background-color: rgb(28, 31, 37); border-radius: 12px; }
.small-card { width: 640px; }
.title { font-size: 40px; -unity-font-style: bold; margin-bottom: 14px; }
.title.big { font-size: 64px; -unity-text-align: middle-center; text-shadow: 2px 2px 6px rgba(0, 0, 0, 1); }
.para { white-space: normal; font-size: 22px; margin-bottom: 8px; }
.para.small { font-size: 18px; color: rgb(185, 190, 200); }
.para.warn { color: rgb(255, 210, 140); }
.para.center { -unity-text-align: middle-center; font-size: 26px; text-shadow: 1px 1px 3px rgba(0, 0, 0, 1); }
.section { font-size: 18px; color: rgb(160, 166, 176); margin-top: 10px; margin-bottom: 2px; }
.row { flex-direction: row; align-items: center; margin-top: 12px; }
.row.end { justify-content: flex-end; }
.field-label { font-size: 21px; -unity-font-style: bold; margin-top: 18px; }
.field { font-size: 26px; margin: 6px 0; }
.field .unity-text-field__input {
    min-height: 54px; padding: 8px 14px;
    background-color: rgb(13, 20, 29); color: rgb(250, 251, 255);
    border-width: 2px; border-color: rgb(89, 110, 131); border-radius: 8px;
    --unity-cursor-color: rgb(250, 251, 255);
    --unity-selection-color: rgba(101, 171, 255, 0.35);
}
.field .unity-text-field__input:focus { border-color: rgb(101, 171, 255); }
.field .unity-text-field__input--placeholder { color: rgb(165, 182, 200); }
.objective {
    position: absolute; top: 24px; left: 28px; max-width: 42%;
    padding: 8px 14px; white-space: normal;
    background-color: rgba(16, 18, 22, 0.88); border-radius: 6px;
}
.server { font-size: 18px; color: rgb(160, 166, 176); margin-top: 6px; }
.button { font-size: 24px; padding: 12px 30px; border-radius: 8px; border-width: 0;
          background-color: rgb(58, 62, 70); color: rgb(240, 242, 245); }
.button.primary { background-color: rgb(60, 120, 220); color: rgb(255, 255, 255); }


.start-card {
    width: 1220px; max-width: 92%; padding: 34px 40px;
    background-color: rgb(23, 32, 44); border-radius: 18px;
    border-width: 1px; border-color: rgb(58, 75, 93);
}
.start-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 18px; }
.start-header .title { font-size: 49px; margin-bottom: 0; }
.start-header .server { color: rgb(186, 206, 226); font-size: 17px; }
.start-body { flex-direction: row; }
.briefing { flex-grow: 1; flex-basis: 0; min-width: 0; padding-right: 30px; }
.controls { width: 410px; padding: 18px 22px; border-radius: 10px; background-color: rgb(31, 44, 58); }
.controls .section { color: rgb(233, 240, 250); -unity-font-style: bold; font-size: 23px; margin-top: 0; margin-bottom: 10px; }
.control-line { font-size: 19px; margin: 5px 0; color: rgb(220, 231, 242); }
.safety-box { margin-top: 12px; padding: 12px 16px; border-radius: 8px; background-color: rgb(54, 43, 30); }
.safety-title { color: rgb(255, 214, 153); -unity-font-style: bold; margin-top: 0; }
.safety-box .para { color: rgb(245, 226, 202); }
.start-button { margin: 12px 0 0 0; min-height: 58px; -unity-font-style: bold; }
.button.primary:hover { background-color: rgb(73, 138, 235); }
.button:disabled { opacity: 0.52; }
.reticle {
    position: absolute; top: 50%; left: 50%; margin-top: -3px; margin-left: -3px;
    width: 6px; height: 6px; border-radius: 3px;
    border-width: 1px; border-color: rgb(17, 22, 29); background-color: rgb(255, 255, 255);
}

.reticle.target-ready { background-color: rgb(126, 255, 181); border-color: rgb(16, 54, 38); }
