{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zone_graph.schema.json",
  "title": "Zone graph (명세서 3장 + 14.5)",
  "type": "object",
  "required": ["schema_version", "building_id", "version", "anchors", "zones", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "building_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "version": {"type": "integer", "minimum": 1},
    "anchors": {
      "type": "object",
      "required": ["A", "B"],
      "additionalProperties": false,
      "properties": {
        "A": {"$ref": "#/$defs/vec3"},
        "B": {"$ref": "#/$defs/vec3"}
      }
    },
    "zones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "vec2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "zone": {
      "type": "object",
      "required": ["id", "type", "name", "polygon", "ceiling_h", "objects"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^z_[a-z0-9_]+$"},
        "type": {"enum": ["room", "corridor", "stair", "elevator_lobby", "exit", "refuge"]},
        "name": {"type": "string", "minLength": 1},
        "polygon": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/vec2"}, "description": "[x,z], counter-clockwise seen from above"},
        "ceiling_h": {"type": "number", "exclusiveMinimum": 0},
        "spawn": {"$ref": "#/$defs/vec3"},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}}
      }
    },
    "object": {
      "type": "object",
      "required": ["id", "kind", "pos"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^o_[a-z0-9_]+$"},
        "kind": {"enum": ["towel", "extinguisher", "phone", "document", "bag", "alarm", "faucet", "elevator_button", "window"]},
        "pos": {"$ref": "#/$defs/vec3"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to", "type", "width", "center", "wall_axis"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^e_[a-z0-9_]+$"},
        "from": {"type": "string", "pattern": "^z_"},
        "to": {"type": "string", "pattern": "^z_"},
        "type": {"enum": ["door", "opening", "stair"]},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "center": {"$ref": "#/$defs/vec2"},
        "wall_axis": {"enum": ["x", "z"], "description": "axis the wall runs along; x = wall parallel to the x axis"},
        "door_open": {"type": "boolean", "description": "initial state, door only (scenario.initial_doors overrides)"},
        "handle": {"oneOf": [{"$ref": "#/$defs/vec3"}, {"type": "null"}]},
        "side_from_handle": {"oneOf": [{"type": "string", "pattern": "^z_"}, {"type": "null"}], "description": "null = handle on both sides"}
      }
    }
  }
}
