{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation_result.schema.json",
  "title": "Evaluator output, also the LLM report input (명세서 7장)",
  "type": "object",
  "required": ["schema_version", "run_id", "outcome", "total_pct", "elapsed_s", "items", "timeline", "weak_zones"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "outcome": {"enum": ["escaped", "rescued", "failed", "timeout", "aborted"]},
    "total_pct": {"type": "integer", "minimum": 0, "maximum": 100},
    "elapsed_s": {"type": "number", "minimum": 0},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "grade", "points", "max", "evidence", "rule_ref"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "grade": {"enum": ["good", "normal", "poor", "na"]},
          "points": {"type": "number", "minimum": 0},
          "max": {"type": "number", "minimum": 0},
          "evidence": {"type": "object"},
          "rule_ref": {"type": "string"}
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object", "required": ["t", "c_head", "zone"], "additionalProperties": false,
        "properties": {"t": {"type": "number"}, "c_head": {"type": "number"}, "zone": {"type": ["string", "null"]}}
      }
    },
    "weak_zones": {"type": "array", "maxItems": 2, "items": {"type": "string"}}
  }
}
