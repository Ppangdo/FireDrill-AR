{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npc_cache.schema.json",
  "title": "NPC reaction cache (명세서 8장, 14.5)",
  "type": "object",
  "required": ["schema_version", "model", "generated_at", "entries", "fallback"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "model": {"type": "string"},
    "generated_at": {"type": "string"},
    "entries": {
      "type": "object",
      "propertyNames": {"pattern": "^npc_[a-z0-9_]+\\|(warn|escort|ignore|none)\\|[0-3]\\|(evacuate|follow_player|freeze|ask_help|go_elevator|hide)$"},
      "additionalProperties": {"$ref": "#/$defs/reaction"}
    },
    "fallback": {
      "type": "object",
      "propertyNames": {"pattern": "^npc_"},
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }
  },
  "$defs": {
    "reaction": {
      "type": "object", "required": ["action", "line", "emotion"], "additionalProperties": false,
      "properties": {
        "action": {"enum": ["evacuate", "follow_player", "freeze", "ask_help", "go_elevator", "hide"]},
        "line": {"type": "string", "maxLength": 60},
        "emotion": {"enum": ["calm", "scared", "panicked", "relieved", "stubborn"]}
      }
    }
  }
}
