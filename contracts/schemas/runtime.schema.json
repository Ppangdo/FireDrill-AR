{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime.schema.json",
  "title": "Runtime tuning: PC controls, scene building, flow timing, networking (명세서 10·14.6·16.2·16.7)",
  "type": "object",
  "required": [
    "schema_version",
    "pc",
    "scene",
    "flow",
    "network",
    "items",
    "effects",
    "audio"
  ],
  "additionalProperties": false,
  "$defs": {
    "pos": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonneg": {
      "type": "number",
      "minimum": 0
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "size3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pos"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "shape": {
      "type": "object",
      "required": [
        "shape",
        "size_m",
        "color",
        "pickable",
        "essential"
      ],
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "box",
            "cylinder"
          ]
        },
        "size_m": {
          "$ref": "#/$defs/size3"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "pickable": {
          "type": "boolean"
        },
        "essential": {
          "type": "boolean",
          "description": "PICKUP.essential (16.10)"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pc": {
      "type": "object",
      "description": "16.7 PC controls. Standing head height is evaluation.json standing_head_m.",
      "required": [
        "walk_speed_mps",
        "crouch_speed_mps",
        "crouch_head_m",
        "posture_switch_s",
        "body_radius_m",
        "mouse_sensitivity_deg",
        "pitch_limit_deg",
        "interact_range_m",
        "handle_range_m",
        "handle_hold_s",
        "faucet_hold_s",
        "abort_hold_s",
        "talk_range_m",
        "pickup_s"
      ],
      "additionalProperties": false,
      "properties": {
        "walk_speed_mps": {
          "$ref": "#/$defs/pos"
        },
        "crouch_speed_mps": {
          "$ref": "#/$defs/pos"
        },
        "crouch_head_m": {
          "$ref": "#/$defs/pos"
        },
        "posture_switch_s": {
          "$ref": "#/$defs/nonneg"
        },
        "body_radius_m": {
          "$ref": "#/$defs/pos"
        },
        "mouse_sensitivity_deg": {
          "$ref": "#/$defs/pos",
          "description": "degrees per mouse delta unit"
        },
        "pitch_limit_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "interact_range_m": {
          "$ref": "#/$defs/pos"
        },
        "handle_range_m": {
          "$ref": "#/$defs/pos"
        },
        "handle_hold_s": {
          "$ref": "#/$defs/nonneg"
        },
        "faucet_hold_s": {
          "$ref": "#/$defs/nonneg"
        },
        "abort_hold_s": {
          "$ref": "#/$defs/nonneg"
        },
        "talk_range_m": {
          "$ref": "#/$defs/pos"
        },
        "pickup_s": {
          "$ref": "#/$defs/nonneg"
        }
      }
    },
    "scene": {
      "type": "object",
      "description": "16.2 SceneBuilder",
      "required": [
        "wall_thickness_m",
        "door_thickness_m",
        "door_top_m",
        "door_swing_s",
        "handle_size_m",
        "exit_sign_size_m",
        "exit_sign_height_m",
        "light_intensity",
        "light_range_m",
        "colors",
        "objects",
        "npc"
      ],
      "additionalProperties": false,
      "properties": {
        "wall_thickness_m": {
          "$ref": "#/$defs/pos"
        },
        "door_thickness_m": {
          "$ref": "#/$defs/pos"
        },
        "door_top_m": {
          "$ref": "#/$defs/pos"
        },
        "door_swing_s": {
          "$ref": "#/$defs/nonneg"
        },
        "handle_size_m": {
          "$ref": "#/$defs/size3"
        },
        "exit_sign_size_m": {
          "$ref": "#/$defs/size3"
        },
        "exit_sign_height_m": {
          "$ref": "#/$defs/pos"
        },
        "light_intensity": {
          "$ref": "#/$defs/nonneg"
        },
        "light_range_m": {
          "$ref": "#/$defs/pos"
        },
        "colors": {
          "type": "object",
          "required": [
            "corridor",
            "room",
            "elevator_lobby",
            "exit",
            "wall",
            "ceiling",
            "door",
            "handle",
            "exit_sign"
          ],
          "additionalProperties": false,
          "properties": {
            "corridor": {
              "$ref": "#/$defs/color"
            },
            "room": {
              "$ref": "#/$defs/color"
            },
            "elevator_lobby": {
              "$ref": "#/$defs/color"
            },
            "exit": {
              "$ref": "#/$defs/color"
            },
            "wall": {
              "$ref": "#/$defs/color"
            },
            "ceiling": {
              "$ref": "#/$defs/color"
            },
            "door": {
              "$ref": "#/$defs/color"
            },
            "handle": {
              "$ref": "#/$defs/color"
            },
            "exit_sign": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "objects": {
          "type": "object",
          "description": "16.10 placeholder shapes per object kind (box or cylinder; size = x, y, z)",
          "required": [
            "towel",
            "extinguisher",
            "phone",
            "document",
            "bag",
            "alarm",
            "faucet",
            "elevator_button",
            "window"
          ],
          "additionalProperties": false,
          "properties": {
            "towel": {
              "$ref": "#/$defs/shape"
            },
            "extinguisher": {
              "$ref": "#/$defs/shape"
            },
            "phone": {
              "$ref": "#/$defs/shape"
            },
            "document": {
              "$ref": "#/$defs/shape"
            },
            "bag": {
              "$ref": "#/$defs/shape"
            },
            "alarm": {
              "$ref": "#/$defs/shape"
            },
            "faucet": {
              "$ref": "#/$defs/shape"
            },
            "elevator_button": {
              "$ref": "#/$defs/shape"
            },
            "window": {
              "$ref": "#/$defs/shape"
            }
          }
        },
        "npc": {
          "type": "object",
          "required": [
            "height_m",
            "radius_m",
            "color"
          ],
          "additionalProperties": false,
          "properties": {
            "height_m": {
              "$ref": "#/$defs/pos"
            },
            "radius_m": {
              "$ref": "#/$defs/pos"
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "description": "5장 GameFlow timing",
      "required": [
        "tick_s",
        "sample_interval_s",
        "ending_s",
        "run_create_wait_s"
      ],
      "additionalProperties": false,
      "properties": {
        "tick_s": {
          "const": 0.1,
          "description": "fire/FED fixed tick (14.1)"
        },
        "sample_interval_s": {
          "$ref": "#/$defs/pos"
        },
        "ending_s": {
          "$ref": "#/$defs/nonneg"
        },
        "run_create_wait_s": {
          "$ref": "#/$defs/pos",
          "description": "max wait for the server run_id before using a local one"
        }
      }
    },
    "network": {
      "type": "object",
      "description": "14.6 client behaviour",
      "required": [
        "request_timeout_s",
        "upload_interval_s",
        "upload_batch_max",
        "retry_delays_s",
        "offline_probe_s",
        "ws_status_interval_s",
        "ws_ping_timeout_s",
        "ws_reconnect_s"
      ],
      "additionalProperties": false,
      "properties": {
        "request_timeout_s": {
          "$ref": "#/$defs/pos"
        },
        "upload_interval_s": {
          "$ref": "#/$defs/pos"
        },
        "upload_batch_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "retry_delays_s": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonneg"
          }
        },
        "offline_probe_s": {
          "$ref": "#/$defs/pos"
        },
        "ws_status_interval_s": {
          "$ref": "#/$defs/pos"
        },
        "ws_ping_timeout_s": {
          "$ref": "#/$defs/pos"
        },
        "ws_reconnect_s": {
          "$ref": "#/$defs/pos"
        }
      }
    },
    "items": {
      "type": "object",
      "required": [
        "bag_slots",
        "extinguisher_capacity_s"
      ],
      "additionalProperties": false,
      "properties": {
        "bag_slots": {
          "type": "integer",
          "minimum": 0
        },
        "extinguisher_capacity_s": {
          "$ref": "#/$defs/pos"
        }
      }
    },
    "effects": {
      "type": "object",
      "required": [
        "smoke_cue_d",
        "subtitle_s",
        "smoke",
        "fog",
        "floor_line",
        "fire",
        "body",
        "subtitles"
      ],
      "additionalProperties": false,
      "properties": {
        "smoke_cue_d": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "CUE_EXPOSED smoke when the trainee's zone D exceeds this (14.5)"
        },
        "subtitle_s": {
          "$ref": "#/$defs/pos"
        },
        "smoke": {
          "type": "object",
          "required": [
            "base_opacity",
            "per_d_opacity",
            "edge_fade_m",
            "lerp_s",
            "color"
          ],
          "additionalProperties": false,
          "properties": {
            "base_opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "per_d_opacity": {
              "$ref": "#/$defs/nonneg"
            },
            "edge_fade_m": {
              "$ref": "#/$defs/nonneg"
            },
            "lerp_s": {
              "$ref": "#/$defs/nonneg"
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "fog": {
          "type": "object",
          "required": [
            "base_density",
            "per_c_density",
            "color"
          ],
          "additionalProperties": false,
          "properties": {
            "base_density": {
              "$ref": "#/$defs/nonneg"
            },
            "per_c_density": {
              "$ref": "#/$defs/nonneg"
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "floor_line": {
          "type": "object",
          "required": [
            "width_m",
            "height_m",
            "color"
          ],
          "additionalProperties": false,
          "properties": {
            "width_m": {
              "$ref": "#/$defs/pos"
            },
            "height_m": {
              "$ref": "#/$defs/nonneg"
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "fire": {
          "type": "object",
          "required": [
            "initial",
            "growing",
            "extinguish_shrink_s",
            "light_intensity",
            "light_range_m",
            "flicker",
            "flame_color",
            "smoke_color",
            "white_smoke_color"
          ],
          "additionalProperties": false,
          "properties": {
            "initial": {
              "type": "object",
              "required": [
                "diameter_m",
                "height_m"
              ],
              "additionalProperties": false,
              "properties": {
                "diameter_m": {
                  "$ref": "#/$defs/pos"
                },
                "height_m": {
                  "$ref": "#/$defs/pos"
                }
              }
            },
            "growing": {
              "type": "object",
              "required": [
                "diameter_m",
                "height_m"
              ],
              "additionalProperties": false,
              "properties": {
                "diameter_m": {
                  "$ref": "#/$defs/pos"
                },
                "height_m": {
                  "$ref": "#/$defs/pos"
                }
              }
            },
            "extinguish_shrink_s": {
              "$ref": "#/$defs/nonneg"
            },
            "light_intensity": {
              "$ref": "#/$defs/nonneg"
            },
            "light_range_m": {
              "$ref": "#/$defs/pos"
            },
            "flicker": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "flame_color": {
              "$ref": "#/$defs/color"
            },
            "smoke_color": {
              "$ref": "#/$defs/color"
            },
            "white_smoke_color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "body": {
          "type": "object",
          "required": [
            "stages",
            "shake_deg",
            "shake_hz",
            "hot_flash_s",
            "hot_color",
            "blur_start_m",
            "blur_end_m"
          ],
          "additionalProperties": false,
          "properties": {
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "vignette",
                  "saturation",
                  "blur_radius"
                ],
                "additionalProperties": false,
                "properties": {
                  "vignette": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "saturation": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "blur_radius": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1.5,
                    "description": "URP Gaussian depth of field max radius; 0 = off"
                  }
                }
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "index = body stage 0..3"
            },
            "shake_deg": {
              "$ref": "#/$defs/nonneg"
            },
            "shake_hz": {
              "$ref": "#/$defs/pos"
            },
            "hot_flash_s": {
              "$ref": "#/$defs/nonneg"
            },
            "hot_color": {
              "$ref": "#/$defs/color"
            },
            "blur_start_m": {
              "$ref": "#/$defs/nonneg"
            },
            "blur_end_m": {
              "$ref": "#/$defs/nonneg"
            }
          }
        },
        "subtitles": {
          "type": "object",
          "description": "one-line subtitles (16.11), shown subtitle_s",
          "required": [
            "sound",
            "smell",
            "smoke",
            "alarm",
            "stage_1",
            "stage_2",
            "stage_3",
            "hot_handle",
            "cool_handle"
          ],
          "additionalProperties": false,
          "properties": {
            "sound": {
              "type": "string"
            },
            "smell": {
              "type": "string"
            },
            "smoke": {
              "type": "string"
            },
            "alarm": {
              "type": "string"
            },
            "stage_1": {
              "type": "string"
            },
            "stage_2": {
              "type": "string"
            },
            "stage_3": {
              "type": "string"
            },
            "hot_handle": {
              "type": "string"
            },
            "cool_handle": {
              "type": "string"
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "volume",
        "alarm_hz",
        "alarm_on_s",
        "alarm_off_s",
        "crackle_volume",
        "hiss_s",
        "spray_volume"
      ],
      "additionalProperties": false,
      "properties": {
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alarm_hz": {
          "$ref": "#/$defs/pos"
        },
        "alarm_on_s": {
          "$ref": "#/$defs/pos"
        },
        "alarm_off_s": {
          "$ref": "#/$defs/pos"
        },
        "crackle_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hiss_s": {
          "$ref": "#/$defs/pos"
        },
        "spray_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
